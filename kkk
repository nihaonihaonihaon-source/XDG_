        if not isfolder(DIR) then pcall(makefolder, DIR) end
    else
        pcall(makefolder, DIR)
    end
    return true
end

local function nextOutputPath()
    if not hasWriteFile then return nil end
    ensureFolder()
    local i = 1
    if hasIsFile then
        while isfile(DIR .. "/qwe." .. i) do i = i + 1 end
    end
    return DIR .. "/qwe." .. i
end

local function saveToFile(content)
    if not hasWriteFile then return nil, "no writefile" end
    if content == nil or content == "" then return nil, "empty" end
    local path = nextOutputPath()
    if not path then return nil, "no path" end
    local ok, err = pcall(writefile, path, content)
    if ok then return path end
    return nil, tostring(err)
end

