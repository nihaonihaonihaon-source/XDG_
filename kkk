        "  if k=='numadd' then return "..F_na.."() end",
        "  if k=='ixor' then return "..F_i1.."() end",
        "  if k=='ix1' then return "..F_i2.."() end",
        "  if k=='ix2' then return "..F_i3.."() end",
        "  if k=='ix3' then return "..F_i4.."() end",
        "  if k=='root' then return "..F_rt.."() end",
        "  if k=='o' then return setmetatable({},{__index=function(_,kk) return "..F_o.."(kk) end}) end",
        "  if k=='omap' then return _omapProxy end",
        "  if k=='p' then return _pProxy end",
        "  if k=='pcount' then return "..pcount.." end",
        "  return nil",
        "end})",
    }, "\n")

    local afterD = src:sub(dend+1)
    afterD = afterD:gsub("%f[%w_]_VM%f[^%w_]", VM_NAME)

    local vmfailRepl
    if report == "release" then
        vmfailRepl = "local function VMFAIL(kind,msg,pc,A,B,C) error(\"E\"..tostring(pc),2) end"
    else
