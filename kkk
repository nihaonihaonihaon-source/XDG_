local function killEnvironmentDetection()
    if not has_hookfunction or not has_checkcaller then return end
    -- Hook getfenv
    pcall(function()
        local oldGetfenv = getfenv
        if type(oldGetfenv) ~= "function" then return end
        local fn = function(f)
            if not checkcaller() then
                local realEnv = oldGetfenv(f)
                local fakeEnv = {}
                for k, v in pairs(realEnv) do
                    if type(k) == "string" and not (
                       string.find(string.lower(k), "hook") or
                       string.find(string.lower(k), "getgc") or
                       string.find(string.lower(k), "bypass") or
                       string.find(string.lower(k), "xdg")) then
                        fakeEnv[k] = v
                    end
                end
                return fakeEnv
            end
            return oldGetfenv(f)
        end
        if has_newcclosure then
            local ok, w = pcall(function() return newcclosure(fn) end)
            if ok and type(w) == "function" then fn = w end
        end
        getfenv = fn
    end)
