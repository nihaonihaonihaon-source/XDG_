-- 统一防错误包装
local function wrap(name,fn)
    return function(...)
        local ok,err=pcall(fn,...)
        if not ok then
            warn("[XDG:"..name.."] "..tostring(err))
        end
        return ok
    end
end
local function SafeCall(name,fn,...)
    local ok,err=pcall(fn,...)
    if not ok then
        warn("[XDG:SafeCall:"..name.."] "..tostring(err))
    end
    return ok
end
genv.XDG_SafeCall=SafeCall

