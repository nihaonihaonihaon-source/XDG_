local function _rndAlpha(n, pre)
    local A = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    local s = pre or "_"
    for _=1,n do
        local i = math.random(1, #A)
        s = s .. A:sub(i,i)
    end
    return s
end

local function _encNum(n)
    local k1 = math.random(1,254)
    local k2 = math.random(1,254)
    local str
    if type(n) == "number" and n == math.floor(n) and math.abs(n) < 2^52 then
        str = string.format("%.0f", n)
    else
        str = tostring(n)
    end
    local enc = {}
    for i=1,#str do
        local b1 = bxor(str:byte(i), (k1+i*37)%256)
        local b2 = bxor(b1, (k2+i*53)%256)
        enc[i] = string.format("\\%03d", b2)
    end
    return table.concat(enc), k1, k2
end

local function _encStr(s)
    local k1 = math.random(1, 254)
    local k2 = math.random(1, 254)
    local out = {}
    for i = 1, #s do
        local b1 = bxor(s:byte(i), (k1 + i * 37) % 256)
        local b2 = bxor(b1, (k2 + i * 53) % 256)
        out[i] = string.format("\\%03d", b2)
    end
    return table.concat(out), k1, k2
end

local function _serVal(v)
    local tv = type(v)
    if tv == "number" then
        if v == math.floor(v) and math.abs(v) < 2^52 then
            return string.format("%.0f", v)
        end
        return tostring(v)
    elseif tv == "string" then
        local out = {}
        for j=1,#v do out[j] = string.format("\\%03d", v:byte(j)) end
        return '"'..table.concat(out)..'"'
    elseif tv == "boolean" then
        return v and "true" or "false"
    elseif tv == "table" then
        local maxn = 0
        for kk,_ in pairs(v) do
            if type(kk)=="number" and kk == math.floor(kk) and kk>=1 then
                if kk > maxn then maxn = kk end
            end
        end
        local parts = {}
        for i2=1,maxn do parts[#parts+1] = _serVal(v[i2]) end
        for kk,vv in pairs(v) do
            local isArrKey = type(kk)=="number" and kk == math.floor(kk) and kk>=1 and kk<=maxn
            if not isArrKey then
                local kstr
                if type(kk)=="string" and kk:match("^[%a_][%w_]*$") then
                    kstr = kk.."="
                else
                    kstr = "[".._serVal(kk).."]="
                end
                parts[#parts+1] = kstr.._serVal(vv)
            end
        end
        return "{"..table.concat(parts,",").."}"
    else
        return "nil"
    end
end

local function _parseD(src)
    local s, e = src:find("local%s+D%s*=%s*")
    if not s then return nil, "未找到 local D=" end
    local depth = 0
    local i = e + 1
    local inStr = nil
    local escaped = false
    while i <= #src do
        local c = src:sub(i,i)
        if inStr then
            if escaped then escaped = false
            elseif c == "\\" then escaped = true
            elseif c == inStr then inStr = nil end
        else
            if c == '"' or c == "'" then inStr = c
            elseif c == "{" then depth = depth + 1
            elseif c == "}" then
                depth = depth - 1
                if depth == 0 then
                    return src:sub(e+1, i), nil, s, i
                end
            end
        end
        i = i + 1
    end
    return nil, "D表未闭合"
end

local function _replaceVMFAIL(s, repl)
    local vstart = s:find("local function VMFAIL(", 1, true)
    if not vstart then return s end
    local p = vstart
    while p <= #s do
        local nl = s:find("\n", p)
        local lineEnd = nl or (#s + 1)
        local line = s:sub(p, lineEnd - 1)
        if line:match("^%s*end%s*;?%s*$") then
            return s:sub(1, vstart-1) .. repl .. s:sub(lineEnd)
        end
        if line:match("local function VMFAIL") and line:match("end%s*$") then
            return s:sub(1, vstart-1) .. repl .. s:sub(lineEnd)
        end
        if not nl then break end
        p = nl + 1
    end
    return s
end

local function hardenVM(src, report)
