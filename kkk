-- ============ 注册表 ============
genv.XDG_REG_KEY_2026 = genv.XDG_REG_KEY_2026 or {}
local REG = genv.XDG_REG_KEY_2026
REG.Scripts = REG.Scripts or {}
REG.Logs = REG.Logs or {}
REG.Listeners = REG.Listeners or {}
REG.LogListeners = REG.LogListeners or {}

function REG:Insert(name, url)
    if not name or name == "" then return end
    for _, s in ipairs(self.Scripts) do
        if s.name == name then
            if url and s.url ~= url then s.url = url end
            return
        end
    end
    table.insert(self.Scripts, { name = name, url = url or "" })
    for _, cb in ipairs(self.Listeners) do pcall(cb, name, url) end
end

function REG:InsertBatch(data)
    if type(data) ~= "string" then return end
    for line in data:gmatch("[^\n]+") do
        local name, url = line:match("^(.-)|(.*)$")
        if name and url and name ~= "" then self:Insert(name, url) end
    end
end

function REG:InsertLog(date, scripts)
    if not date then return end
    for _, l in ipairs(self.Logs) do if l.Date == date then return end end
    table.insert(self.Logs, { Date = date, Scripts = scripts or {} })
    for _, cb in ipairs(self.LogListeners) do pcall(cb, date, scripts) end
end

function REG:InsertLogBatch(data)
    if type(data) ~= "string" then return end
    for line in data:gmatch("[^\n]+") do
        local date, list = line:match("^(.-)|(.*)$")
        if date and list then
            local scripts = {}
            for s in list:gmatch("[^\t]+") do table.insert(scripts, s) end
            self:InsertLog(date, scripts)
        end
    end
end

function REG:OnInsert(cb)
    table.insert(self.Listeners, cb)
    for _, s in ipairs(self.Scripts) do pcall(cb, s.name, s.url) end
end

function REG:OnInsertLog(cb)
    table.insert(self.LogListeners, cb)
    for _, l in ipairs(self.Logs) do pcall(cb, l.Date, l.Scripts) end
end

