local pushSpeed=wrap("pushSpeed",function(dt)
    if not CR2 or not CR2.Parent then SMOOTH_VEL=0 return end
    if not CH2 or not CH2.Parent then SMOOTH_VEL=0 return end

    if isSensitive() then
        SMOOTH_VEL=math.max(0,SMOOTH_VEL-SMOOTH_ACCEL*2)
        return
    end

    if not IG2() then
        SMOOTH_VEL=math.max(0,SMOOTH_VEL-SMOOTH_ACCEL*2)
        return
    end

    local mv=CH2.MoveDirection
    if mv.Magnitude<STOP2 then
        SMOOTH_VEL=math.max(0,SMOOTH_VEL-SMOOTH_ACCEL*2)
        return
    end

    local target=RS2()
    if target<=16 then
        SMOOTH_VEL=math.max(0,SMOOTH_VEL-SMOOTH_ACCEL*2)
        return
    end

    local step=SMOOTH_ACCEL*math.max(dt,0.001)
    if SMOOTH_VEL<target then
        SMOOTH_VEL=math.min(target,SMOOTH_VEL+step)
    elseif SMOOTH_VEL>target then
        SMOOTH_VEL=math.max(target,SMOOTH_VEL-step)
    end

    local jitter=1+(math.random()-0.5)*0.1
    local vel=SMOOTH_VEL*jitter

    -- 帧级限速：本帧位移不超过 14.5 studs
    local frameDist=vel*math.max(dt,0.001)
    if frameDist>MAX_STEP2 then
        vel=MAX_STEP2/math.max(dt,0.001)
    end

    local dir=Vector3.new(mv.X,0,mv.Z).Unit
    local cur=CR2.AssemblyLinearVelocity
    local goal=Vector3.new(dir.X*vel,cur.Y,dir.Z*vel)

    local delta=(goal-cur).Magnitude
    if delta>VELOCITY_MUTATION_LIMIT then return end

    lastPushed=os.clock()
    CR2.AssemblyLinearVelocity=goal
    CR2.AssemblyAngularVelocity=Vector3.zero
end)

