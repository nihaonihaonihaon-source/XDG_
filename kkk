local bxor
if type(bit32)=="table" and type(bit32.bxor)=="function" then
    bxor = bit32.bxor
else
    bxor = function(a,b)
        local r,p=0,1
        while a>0 or b>0 do
            local xa,xb=a%2,b%2
            if xa~=xb then r=r+p end
            a=(a-xa)/2;b=(b-xb)/2;p=p*2
        end
        return r
    end
end

