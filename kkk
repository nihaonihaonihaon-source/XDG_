function REG:InsertLogBatch(d)if type(d)~="string"then return end;for l in d:gmatch("[^\n]+")do local dt,li=l:match("^(.-)|(.*)$")if dt and li then local sc={}for s in li:gmatch("[^\t]+")do table.insert(sc,s)end;self:InsertLog(dt,sc)end end end
