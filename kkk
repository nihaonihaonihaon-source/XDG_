local function rc4(key, data)
    local S = {}
    for i = 0, 255 do S[i] = i end
    local j = 0
    for i = 0, 255 do
        j = (j + S[i] + key:byte((i % #key) + 1)) % 256
        S[i], S[j] = S[j], S[i]
    end
    local out, a, b = {}, 0, 0
    for m = 1, #data do
        a = (a + 1) % 256
        b = (b + S[a]) % 256
        S[a], S[b] = S[b], S[a]
        local k = S[(S[a] + S[b]) % 256]
        out[m] = string.char(bxor(data:byte(m), k))
    end
    return table.concat(out)
end

local function chacha20(key, nonce, data)
    local b = bit32
    if not b then return data end
    local bor, lshift, rshift, bxor32 = b.bor, b.lshift, b.rshift, b.bxor
    local function rotl(x, n) return bor(lshift(x, n), rshift(x, 32 - n)) end
    local function qr(a, c, d, e)
        a = (a + c) % 4294967296; e = rotl(bxor32(e, a), 16)
        d = (d + e) % 4294967296; c = rotl(bxor32(c, d), 12)
        a = (a + c) % 4294967296; e = rotl(bxor32(e, a), 8)
        d = (d + e) % 4294967296; c = rotl(bxor32(c, d), 7)
        return a, c, d, e
    end
    local function L(s, o)
        local x, y, z, w = s:byte(o+1, o+4)
        return x + y*256 + z*65536 + w*16777216
    end
    local K = {}
    for i = 0, 7 do K[i+1] = L(key, i*4) end
    local N = {}
    for i = 0, 2 do N[i+1] = L(nonce, i*4) end
    local C = {0x61707865, 0x3320646e, 0x79622d32, 0x6b206574}
    local out = {}
    local ctr = 0
    for off = 1, #data, 64 do
        local s = {C[1],C[2],C[3],C[4],K[1],K[2],K[3],K[4],K[5],K[6],K[7],K[8],ctr,N[1],N[2],N[3]}
        local w = {s[1],s[2],s[3],s[4],s[5],s[6],s[7],s[8],s[9],s[10],s[11],s[12],s[13],s[14],s[15],s[16]}
        for i = 1, 10 do
            w[1],w[5],w[9],w[13]  = qr(w[1],w[5],w[9],w[13])
            w[2],w[6],w[10],w[14] = qr(w[2],w[6],w[10],w[14])
            w[3],w[7],w[11],w[15] = qr(w[3],w[7],w[11],w[15])
            w[4],w[8],w[12],w[16] = qr(w[4],w[8],w[12],w[16])
            w[1],w[6],w[11],w[16] = qr(w[1],w[6],w[11],w[16])
            w[2],w[7],w[12],w[13] = qr(w[2],w[7],w[12],w[13])
            w[3],w[8],w[9],w[14]  = qr(w[3],w[8],w[9],w[14])
            w[4],w[5],w[10],w[15] = qr(w[4],w[5],w[10],w[15])
        end
        local ks = {}
        for i = 1, 16 do
            local v = (w[i] + s[i]) % 4294967296
            ks[i*4-3] = v % 256
            ks[i*4-2] = math.floor(v / 256) % 256
            ks[i*4-1] = math.floor(v / 65536) % 256
            ks[i*4]   = math.floor(v / 16777216) % 256
        end
        local lim = math.min(64, #data - off + 1)
        for j = 1, lim do
            out[#out+1] = string.char(bxor32(data:byte(off+j-1), ks[j]))
        end
        ctr = ctr + 1
    end
    return table.concat(out)
end

local function xorMask(data, mask)
    local ml = #mask
    if ml == 0 then return data end
    local out = {}
    for i = 1, #data do
        out[i] = string.char(bxor(data:byte(i), mask:byte(((i - 1) % ml) + 1)))
    end
    return table.concat(out)
end

local function splitIntoChunks(s, n)
    if #s < n then n = math.max(1, #s) end
    if n < 1 then n = 1 end
    local chunk = math.ceil(#s / n)
    if chunk < 1 then chunk = 1 end
    local parts = {}
    for i = 1, #s, chunk do
        parts[#parts + 1] = s:sub(i, i + chunk - 1)
    end
    return parts
end

local function toEscapedLiteral(s)
    local parts = {}
    for i = 1, #s do
        parts[i] = string.format("\\%03d", s:byte(i))
    end
    return '"' .. table.concat(parts) .. '"'
end

local function xs32(x)
    x = x % 4294967296
    local t = (x * 8192) % 4294967296
    x = bxor(x, t) % 4294967296
    t = math.floor(x / 131072)
    x = bxor(x, t) % 4294967296
    t = (x * 32) % 4294967296
    x = bxor(x, t) % 4294967296
    return x % 4294967296
end

local CHARSET = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
local function deriveKey(seed, len)
    local r, x = {}, seed % 4294967296
    for i = 1, len do
        x = xs32(x)
        local b = x % 256
        r[i] = CHARSET:sub((b % #CHARSET) + 1, (b % #CHARSET) + 1)
    end
    return table.concat(r)
end

local POOL = {
    {name="ChaCha20",     w=5},
    {name="RC4",          w=5},
    {name="XOR",          w=3},
    {name="RC4_XOR",      w=4},
    {name="ChaCha20_XOR", w=3},
}
local TOTAL_W = 0
for _,e in ipairs(POOL) do TOTAL_W = TOTAL_W + e.w end

local function deriveLayerConfig(seed, layerCount)
    local cfg, s = {}, seed % 4294967296
    local function nr(mod)
        s = xs32(s)
        return (s % mod) + 1
    end
    for i = 1, layerCount do
        local r, acc, algo = nr(TOTAL_W), 0, "RC4"
        for _,e in ipairs(POOL) do
            acc = acc + e.w
            if r <= acc then algo = e.name; break end
        end
        local c = {t = algo}
        if algo == "ChaCha20" then c.klen=100; c.nlen=100
        elseif algo == "RC4" then c.klen=100
        elseif algo == "XOR" then c.klen=100
        elseif algo == "RC4_XOR" then c.klen=100; c.k2len=100
        elseif algo == "ChaCha20_XOR" then c.klen=100; c.nlen=100; c.k2len=100 end
        c.k = deriveKey(nr(4294967296), c.klen)
        if c.nlen  then c.n  = deriveKey(nr(4294967296), c.nlen)  end
        if c.k2len then c.k2 = deriveKey(nr(4294967296), c.k2len) end
        cfg[i] = c
    end
    return cfg
end

local function encLayer(t, data, k1, k2, n)
    if t == "ChaCha20"     then return chacha20(k1, n, data) end
    if t == "RC4"          then return rc4(k1, data) end
    if t == "XOR"          then return xorMask(data, k1) end
    if t == "RC4_XOR"      then return xorMask(rc4(k1, data), k2) end
    if t == "ChaCha20_XOR" then return xorMask(chacha20(k1, n, data), k2) end
    return data
end

