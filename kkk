    pre[#pre+1] = makeNumField(D.root or 0, F_rt)

    do
        local oParts = {}
        for k, v in pairs(D.o or {}) do
            local enc, k1, k2 = _encNum(v)
            oParts[#oParts+1] = string.format("[%q]={\"%s\",%d,%d}", k, enc, k1, k2)
        end
        pre[#pre+1] = "local "..F_o.."_d={"..table.concat(oParts,",").."}"
        pre[#pre+1] = string.format(
            "local %s_c={} local function %s(k) local c=%s_c[k] if c then return c end local d=%s_d[k] if not d then return nil end local v=%s(d[1],d[2],d[3]) %s_c[k]=v %s_d[k]=nil return v end",
            F_o, F_o, F_o, F_o, F_dc, F_o, F_o)
