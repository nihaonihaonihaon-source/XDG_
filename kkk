        local k = deriveKey(kseed, FCS_KEYLEN)
        local n = fcsNonceGen()
        fcsLayers[i] = { k = k, n = n }
    end

    local outer = eN
    for i = 1, FCS_LAYERS do
        local c = FCS.new(fcsLayers[i].k, fcsLayers[i].n)
        outer = c:encrypt(outer, "L" .. i)
    end
    local finalPayload = outer

