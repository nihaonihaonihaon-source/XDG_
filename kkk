-- 敏感属性读写 hook
local IH2=wrap("IH2",function()
    if HI2 then return end
    if not(A2.g and A2.sr)then return end
    local m=t2.g(game)
    if not m or type(m)~="table"then return end
    if not ORIGINAL2.__index then
        ORIGINAL2.__index=m.__index
        ORIGINAL2.__newindex=m.__newindex
        ORIGINAL2.__namecall=m.__namecall
    end
    t2.sr(m,false)
    local oi=m.__index
    local on=m.__newindex
    local onc=m.__namecall
    if type(oi)~="function"or type(on)~="function"then t2.sr(m,true)return end

    local fi=function(s,k)
        if CH2 and s==CH2 and SPF2[k]then
            local ok,v=pcall(oi,s,k)
            if ok and v~=nil then return v end
            return SPF2[k]
        end
        if CH2 and s==CH2 and SENSITIVE_READ2[k]then
            if k=="Health"or k=="MaxHealth"then
                local ok,v=pcall(oi,s,k)
                if ok then return v end
            end
            if k=="Velocity"or k=="AssemblyLinearVelocity" then
                if SP2 and CH2 and CH2.MoveDirection.Magnitude>0.1 then
                    local fv=CH2.MoveDirection.Unit*16
                    return Vector3.new(fv.X,0,fv.Z)
                end
            end
        end
        if CR2 and s==CR2 and (k=="Velocity"or k=="AssemblyLinearVelocity"or k=="CFrame"or k=="Position")then
            if SP2 and CH2 and CH2.MoveDirection.Magnitude>0.01 then
                local d=CH2.MoveDirection.Unit
                local ok,v=pcall(oi,s,k)
                if k=="CFrame" or k=="Position" then
                    return ok and v or CR2.CFrame
                end
                local y=ok and typeof(v)=="Vector3"and v.Y or 0
                return Vector3.new(d.X*16,y,d.Z*16)
            end
        end
        return oi(s,k)
    end
    local fn=function(s,k,v)
        if CH2 and s==CH2 and SPF2[k]then return end
        if CH2 and s==CH2 and SENSITIVE_WRITE2[k]then
            if k=="Health"or k=="MaxHealth"then return end
            if k=="WalkSpeed"or k=="JumpPower"or k=="JumpHeight"or k=="HipHeight"then return end
        end
        if CR2 and s==CR2 and SENSITIVE_WRITE2[k]then
            if SP2 then return end
        end
        return on(s,k,v)
    end
    m.__index=fi
    m.__newindex=fn
    if type(onc)=="function"and A2.ncm then
        local fnam=function(s,...)
            local md=t2.ncm()
            if md=="FireServer"or md=="InvokeServer"then
                local args={...}
                for _,a in ipairs(args)do
                    if type(a)=="table"then
                        if a.speed or a.walkspeed or a.velocity or a.pos or a.position or a.movement or a.move or a.delta or a.dist then return nil end
                    elseif type(a)=="Vector3"then
                        if a.Magnitude>60 then return nil end
                    elseif type(a)=="CFrame"then
                        if a.Position.Magnitude>1000 then return nil end
                    elseif type(a)=="number"then
                        if a>500 or a<-500 then return nil end
                    end
                end
            end
            if (md=="Kick" or md=="kick") and s==L2 then return nil end
            return onc(s,...)
        end
        m.__namecall=fnam
    end
    ORI2.__index=m.__index
    ORI2.__newindex=m.__newindex
    ORI2.__namecall=m.__namecall
    t2.sr(m,true)
    HI2=true
end)

