local function createVelocity()
    if not currentRoot or not currentRoot.Parent then return end
    if velocityForce and velocityForce.Parent then return end
    local linearSupported = false
    pcall(function()
        local t = Instance.new("LinearVelocity")
        t.Parent = game
        t:Destroy()
        linearSupported = true
    end)
    if linearSupported then
        local att = nil
        pcall(function() att = currentRoot:FindFirstChildOfClass("Attachment") end)
        if not att then pcall(function() att = Instance.new("Attachment", currentRoot) end) end
        if att then
            local ok, lv = pcall(function()
                local v = Instance.new("LinearVelocity")
                v.Name = "HumanoidLinear"
                v.Attachment0 = att
                v.MaxForce = 1e5
                v.RelativeTo = Enum.ActuatorRelativeTo.World
                v.VectorVelocity = Vector3.zero
                v.Parent = currentRoot
                return v
            end)
            if ok and lv then
                velocityForce = lv
                velocityAttachment = att
                return
            end
        end
    end
    local ok2, bv = pcall(function()
        local v = Instance.new("BodyVelocity")
        v.Name = "HumanoidBody"
        v.MaxForce = Vector3.new(math.huge, 0, math.huge)
        v.P = 2500
        v.Velocity = Vector3.zero
        v.Parent = currentRoot
        return v
    end)
    if ok2 and bv then velocityForce = bv end
end

local function startSpeed()
    if not currentHumanoid or not currentRoot then return end
    installHook()
    createVelocity()
    applyWalkSpeed(0)
end

local function stopSpeed()
    clearVelocity()
    freezeCharacter()
    applyWalkSpeed(16)
end

local function resyncAll()
    local now = tick()
    if now - lastResync < RESYNC_COOLDOWN then return end
    lastResync = now
    hookInstalled = false
    clearVelocity()
    task.defer(function()
        pcall(function()
            if currentHumanoid and currentRoot then
                installHook()
                if IS_SPEEDING then
                    createVelocity()
                    applyWalkSpeed(0)
                end
            end
        end)
    end)
end

RunService.PreSimulation:Connect(function()
    pcall(function()
        if not currentHumanoid or not currentHumanoid.Parent or not currentRoot or not currentRoot.Parent then
            clearVelocity()
            return
        end
        if not IS_SPEEDING then
            desiredVelocity = Vector3.zero
            if velocityForce and velocityForce.Parent then clearVelocity() end
            return
        end
        local state = currentHumanoid:GetState()
        local grounded = (state == Enum.HumanoidStateType.Running
                       or state == Enum.HumanoidStateType.RunningNoPhysics
                       or state == Enum.HumanoidStateType.Landed
                       or state == Enum.HumanoidStateType.Seated)
        isGrounded = grounded
        local now = tick()
        if isGrounded and (now - lastCollisionTime) < COLLISION_DURATION then
            currentSpeedMultiplier = COLLISION_SLOW_FACTOR
        else
            currentSpeedMultiplier = 1
        end
        local mv = currentHumanoid.MoveDirection
        if mv.Magnitude > STOP_THRESHOLD then
            lastMoveDir = mv.Unit
        end
        if not isGrounded then
            if velocityForce and velocityForce.Parent then
                local realTarget = REAL_SPEED_BASE * (UI_SPEED / 200) * currentSpeedMultiplier
                if realTarget <= 16 then realTarget = UI_SPEED end
                if velocityForce:IsA("LinearVelocity") then
                    velocityForce.VectorVelocity = Vector3.new(lastMoveDir.X * realTarget, 0, lastMoveDir.Z * realTarget)
                end
            end
            return
        end
        if mv.Magnitude > STOP_THRESHOLD then
            lastMoveDir = mv.Unit
        else
            desiredVelocity = Vector3.zero
            if velocityForce and velocityForce.Parent then
                if velocityForce:IsA("LinearVelocity") then
                    velocityForce.VectorVelocity = Vector3.zero
                else
                    velocityForce.Velocity = Vector3.zero
                end
            end
            pcall(function()
                currentRoot.AssemblyLinearVelocity = Vector3.new(0, currentRoot.AssemblyLinearVelocity.Y, 0)
            end)
            return
        end
        local realTarget = REAL_SPEED_BASE * (UI_SPEED / 200) * currentSpeedMultiplier
        if realTarget <= 16 then realTarget = UI_SPEED end
        local jitter = 1 + (math.random() - 0.5) * 0.12
        local speed = realTarget * jitter
        local dir = lastMoveDir
        local currentVel = currentRoot.AssemblyLinearVelocity
        desiredVelocity = Vector3.new(dir.X * speed, currentVel.Y, dir.Z * speed)
        if velocityForce and velocityForce.Parent then
            if velocityForce:IsA("LinearVelocity") then
                velocityForce.VectorVelocity = Vector3.new(dir.X * speed, 0, dir.Z * speed)
            else
                velocityForce.Velocity = Vector3.new(dir.X * speed, 0, dir.Z * speed)
            end
        end
    end)
end)

RunService.PostSimulation:Connect(function()
    pcall(function()
        if not IS_SPEEDING then return end
        if not currentRoot or not currentRoot.Parent then return end
        if not isGrounded then return end
        local actual = currentRoot.AssemblyLinearVelocity
        local dx = actual.X - desiredVelocity.X
        local dz = actual.Z - desiredVelocity.Z
        local deviation = math.sqrt(dx * dx + dz * dz)
        if deviation > COLLISION_TOLERANCE then
            lastCollisionTime = tick()
            currentRoot.AssemblyLinearVelocity = Vector3.new(desiredVelocity.X, actual.Y, desiredVelocity.Z)
        end
        local angVel = currentRoot.AssemblyAngularVelocity
        if math.abs(angVel.Y) > 3 or math.abs(angVel.X) > 3 or math.abs(angVel.Z) > 3 then
            currentRoot.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end)

RunService.Heartbeat:Connect(function()
    pcall(function()
        if not currentHumanoid or not currentHumanoid.Parent or not currentRoot or not currentRoot.Parent then return end
        if not IS_SPEEDING then return end
        local now = tick()
        local pos = currentRoot.Position
        local dist = (pos - lastPos).Magnitude
        local teleported = (dist > TELEPORT_DISTANCE and (now - lastPosTime) < TELEPORT_WINDOW)
        local wsReset = (currentHumanoid.WalkSpeed > 1)
        local velStuck = false
        if currentRoot.AssemblyLinearVelocity.Magnitude < 0.1 and currentHumanoid.MoveDirection.Magnitude > 0.1 then
            zeroFrames = zeroFrames + 1
            if zeroFrames > STUCK_FRAMES then
                velStuck = true
                zeroFrames = 0
            end
        else
            zeroFrames = 0
        end
        if teleported or wsReset or velStuck then
            resyncAll()
        end
        lastPos = pos
        lastPosTime = now
    end)
end)

RunService.RenderStepped:Connect(function()
    pcall(function()
        if not currentHumanoid or not currentHumanoid.Parent then return end
        local animator = currentHumanoid:FindFirstChildOfClass("Animator")
        if not animator then return end
        local ok, tracks = pcall(function() return animator:GetPlayingAnimationTracks() end)
        if not ok or type(tracks) ~= "table" then return end
        local targetRatio = 1
        if IS_SPEEDING and UI_SPEED > ANIM_SLOW_THRESHOLD then
            targetRatio = ANIM_SLOW_THRESHOLD / UI_SPEED
        end
        for _, track in ipairs(tracks) do
            pcall(function()
                if math.abs(track.Speed - targetRatio) > 0.01 then
                    track:AdjustSpeed(targetRatio)
                end
            end)
        end
    end)
end)

