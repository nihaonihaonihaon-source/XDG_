    pre[#pre+1] = "local function "..F_ks.."() return {"..table.concat(ksCalls,",").."} end"

    local function makeNumField(val, fname)
        local enc, k1, k2 = _encNum(val)
        return string.format("local function %s() return %s(\"%s\",%d,%d) end", fname, F_dc, enc, k1, k2)
    end

    pre[#pre+1] = makeNumField(D.nummask or 0, F_nm)
    pre[#pre+1] = makeNumField(D.numadd or 0, F_na)
    pre[#pre+1] = makeNumField(D.ixor or 0, F_i1)
    pre[#pre+1] = makeNumField(D.ix1 or 0, F_i2)
