    add("    if false then error('X') end "..PC.."="..PC.."+1")
    add("  elseif "..OP.."=="..OM.FAKE2.." then")
    add("    if _pred and false then error('Y') end "..PC.."="..PC.."+1")
    add("  else error('OP:'..tostring("..OP..")) end")
    add("end")

    return table.concat(L, "\n")
end

