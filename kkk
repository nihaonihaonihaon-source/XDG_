local function genOpcodeMap()
    local used, map = {}, {}
    local function pick()
        local v
        repeat v = math.random(0, 255) until not used[v]
        used[v] = true
        return v
    end
    map.LOAD=pick();map.CALL=pick();map.HALT=pick()
    map.NOP=pick();map.JUMP=pick();map.FAKE1=pick();map.FAKE2=pick()
    return map
end

local function shardKey100(key, layerSeed)
    local n = #key
    if n < 100 then
        local pad = {}
        for i = 1, 100 - n do pad[i] = string.char(math.random(0,255)) end
        key = key .. table.concat(pad)
    elseif n > 100 then
        key = key:sub(1, 100)
    end
    local shards = {}
    for i = 1, 100 do
        local b = key:byte(i)
        local mv = (layerSeed * 31 + i * 17 + 113) % 256
        shards[i] = bxor(b, mv)
    end
    return shards
end

local function makeShuffleOrder()
    local order = {}
    for i = 1, 100 do order[i] = i end
    for i = 100, 2, -1 do
        local j = math.random(1, i)
        order[i], order[j] = order[j], order[i]
    end
    return order
end

local function shuffleShards(shards, order)
    local out = {}
    for i = 1, 100 do out[i] = shards[order[i]] end
    return out
end

local function computeGuard(seed, values)
    local h = 5381
    local function mix(n)
        local s = tostring(n)
        for i = 1, #s do h = (h * 33 + s:byte(i)) % 4294967296 end
    end
    mix(seed)
    for i = 1, #values do mix(values[i]) end
    return h
end

local function fcsNonceGen()
    local parts = {}
    for i = 1, 4 do
        parts[i] = string.format("%08x", math.random(0, 0xFFFFFFFF))
    end
    return table.concat(parts)
end

