end

local function isSensitive()
    if not CH2 or not CH2.Parent then return true end
    if CH2.FloorMaterial==Enum.Material.Air then return true end
    local ok,st=pcall(function()return CH2:GetState()end)
    if ok and st then
        if st==Enum.HumanoidStateType.Physics
            or st==Enum.HumanoidStateType.Ragdoll
            or st==Enum.HumanoidStateType.FallingDown
            or st==Enum.HumanoidStateType.PlatformStanding then
            return true
        end
    end
    if CH2.Sit or CH2.PlatformStand then return true end
    if os.clock()<lagBackUntil then return true end
    local num=tonumber(L2:GetAttribute("RagdollEndTime"))
    if num and num>workspace:GetServerTimeNow() then
        lagBackUntil=os.clock()+LAG_BACK_COOLDOWN
        return true
    end
    return false
end

local detectLagBack=wrap("detectLagBack",function()
    if not CR2 or not CR2.Parent then return end
    if not CH2 or not CH2.Parent then return end
    local cur=CR2.Position
    local mv=CH2.MoveDirection
    if not lastPos then lastPos=cur return end
    local delta=cur-lastPos
    local dist=delta.Magnitude
    lastPos=cur
    if dist<LAG_BACK_DIST then return end
    if mv.Magnitude<0.1 then return end
    local dot=delta.Unit:Dot(mv.Unit)
    if dot<LAG_BACK_DOT then
        lagBackUntil=os.clock()+LAG_BACK_COOLDOWN
        SMOOTH_VEL=0
        pcall(function()
            local v0=CR2.AssemblyLinearVelocity
            CR2.AssemblyLinearVelocity=Vector3.new(0,v0.Y,0)
            CR2.AssemblyAngularVelocity=Vector3.zero
        end)
    end
end)

