local function installGCHiding()
    if not has_getgc then return end
    pcall(function()
        local oldGetGC = getgc
        local fn = function(includeTables)
            local objects = oldGetGC(includeTables)
            if type(objects) ~= "table" then return objects end
            local filtered = {}
            for _, obj in ipairs(objects) do
                local ok, name = pcall(function() return obj.Name end)
                if not ok or (type(name) == "string" and not name:find("XDG")) then
                    table.insert(filtered, obj)
