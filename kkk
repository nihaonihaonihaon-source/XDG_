local setupDeathBlock=wrap("setupDeathBlock",function()
    if not CH2 then return end
    for _,c in ipairs(deathConns) do
        pcall(function() c:Disconnect() end)
    end
    deathConns={}

    if t2.gc then
        local conns=t2.gc(CH2.Died)
        if conns then
            for _,c in ipairs(conns) do
                pcall(function() c:Disable() end)
            end
        end
    end

    table.insert(deathConns, R2.Heartbeat:Connect(function()
        if not deathBlocked then return end
        if os.clock()<lagBackUntil then return end
        if not CH2 or not CH2.Parent then return end
        pcall(function()
            if CH2.Health < CH2.MaxHealth then
                CH2.Health = CH2.MaxHealth
            end
        end)
        freezeHumanoidState(CH2)
    end))

    if hookmetamethod and newcclosure then
        pcall(function()
            local mt = getrawmetatable(game)
            local oldNamecall = mt.__namecall
            if oldNamecall then
                setreadonly(mt, false)
                mt.__namecall = newcclosure(function(self, ...)
                    local method = getnamecallmethod()
                    if deathBlocked and self == CH2 and (method == "TakeDamage" or method == "BreakJoints") then
                        return nil
                    end
                    if (method == "Kick" or method == "kick") and self == L2 then
                        return nil
                    end
                    return oldNamecall(self, ...)
                end)
                setreadonly(mt, true)
            end
        end)
    end

    blockDeathReplication(CH2)
end)

