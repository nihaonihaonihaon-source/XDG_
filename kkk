local EXPAND_H, COLLAPSE_H = 280, 28
local contentTweens = {}

local function cancelContentTweens()
    for _, t in ipairs(contentTweens) do
        if t then t:Cancel() end
    end
    contentTweens = {}
end

local function setContentAlpha(a, d)
    d = d or 0.18
    cancelContentTweens()
    contentTweens[#contentTweens + 1] = tween(SearchBox, { BackgroundTransparency = 1 - (1 - COLOR.SearchTrans) * a, TextTransparency = 1 - a }, d)
    contentTweens[#contentTweens + 1] = tween(SearchBtn, { BackgroundTransparency = 1 - (1 - 0.2) * a, TextTransparency = 1 - a }, d)
    contentTweens[#contentTweens + 1] = tween(ListContainer, { BackgroundTransparency = 1 - (1 - COLOR.ListTrans) * a }, d)
    for _, item in pairs(Items) do
        contentTweens[#contentTweens + 1] = tween(item.Frame, { BackgroundTransparency = 1 - (1 - COLOR.ItemTrans) * a }, d)
    end
end

local function showContent()
    SearchBox.Visible = true
    SearchBtn.Visible = true
    ListContainer.Visible = true
    SearchBox.TextTransparency = 1
    SearchBox.BackgroundTransparency = 1
    SearchBtn.TextTransparency = 1
    SearchBtn.BackgroundTransparency = 1
    ListContainer.BackgroundTransparency = 1
    setContentAlpha(1, 0.22)
end

local function hideContent()
    setContentAlpha(0, 0.15)
    task.delay(0.15, function()
        if Minimized then
            SearchBox.Visible = false
            SearchBtn.Visible = false
            ListContainer.Visible = false
        end
    end)
end

