    local F_nm   = rnd("_getN")
    local F_na   = rnd("_getA")
    local F_i1   = rnd("_getI")
    local F_i2   = rnd("_getI")
    local F_i3   = rnd("_getI")
    local F_i4   = rnd("_getI")
    local F_rt   = rnd("_getR")
    local F_omap = rnd("_lookup")
    local F_p    = rnd("_fetch")
    local VM_NAME = rnd("_upd")
    local F_o    = rnd("_getO")

    local pre = {}
    pre[#pre+1] = "-- hardened v18.6"
    pre[#pre+1] = "local "..F_bx.."=(bit32 and bit32.bxor)or function(a,b)local r,p=0,1;while a>0 or b>0 do local xa,xb=a%2,b%2;if xa~=xb then r=r+p end;a=(a-xa)/2;b=(b-xb)/2;p=p*2 end;return r end"
    pre[#pre+1] = "local function "..F_dc.."(s,k1,k2) local o={} for i=1,#s do local b=s:byte(i) b="..F_bx.."(b,(k2+i*53)%256) b="..F_bx.."(b,(k1+i*37)%256) o[i]=b end return tonumber(string.char(table.unpack(o))) end"

    local ksFns = {}
    for i=1,#D.ks do
        local fn = rnd("_k")
