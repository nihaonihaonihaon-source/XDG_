-- ============ 反作弊绕过层 ============
local BYPASS = {
    enabled = true,
    spoofed = { WalkSpeed = 16, JumpPower = 50, JumpHeight = 7.2, HipHeight = 2 },
    keywords = {
        "anticheat", "anti_cheat", "ac_", "speedcheck", "report", "detect", "kick", "ban",
        "hack", "velocity", "bodyvelocity", "linearvelocity", "bodyforce",
        "move", "position", "warp", "teleport", "movement", "check",
        "exploit", "suspicious", "violation", "violate",
    },
}

local function isSuspiciousName(name)
    if not name then return false end
    local lower = string.lower(name)
    for _, kw in ipairs(BYPASS.keywords) do
        if lower:find(kw, 1, true) then return true end
    end
    return false
end

local function isAntiCheatRelated(obj)
    if not obj or not obj.Name then return false end
    return isSuspiciousName(obj.Name)
end

local function installHook()
    if hookInstalled then return end
    if not (has_getrawmetatable and has_setreadonly) then return end
    pcall(function()
        local mt = getrawmetatable(game)
        if not mt or type(mt) ~= "table" then return end
        setreadonly(mt, false)
        local oldIndex = mt.__index
        local oldNewIndex = mt.__newindex
        if type(oldIndex) ~= "function" or type(oldNewIndex) ~= "function" then return end
        local fnIdx = function(t, k)
            if currentHumanoid and t == currentHumanoid and BYPASS.spoofed[k] then
                return BYPASS.spoofed[k]
            end
            if currentRoot and t == currentRoot and (k == "AssemblyLinearVelocity" or k == "Velocity") then
                local realVel = oldIndex(t, k)
                if IS_SPEEDING and currentHumanoid and currentHumanoid.MoveDirection.Magnitude > 0.1 then
                    local fakeVel = currentHumanoid.MoveDirection.Unit * 16
                    return Vector3.new(fakeVel.X, realVel.Y, fakeVel.Z)
                end
                return realVel
            end
            return oldIndex(t, k)
        end
        local fnNew = function(t, k, v)
            if currentHumanoid and t == currentHumanoid and BYPASS.spoofed[k] then
                return
            end
            if currentRoot and t == currentRoot and (k == "AssemblyLinearVelocity" or k == "Velocity") then
                if IS_SPEEDING then return end
            end
            return oldNewIndex(t, k, v)
        end
        if has_newcclosure then
            local ok1, w1 = pcall(function() return newcclosure(fnIdx) end)
            if ok1 and type(w1) == "function" then fnIdx = w1 end
            local ok2, w2 = pcall(function() return newcclosure(fnNew) end)
            if ok2 and type(w2) == "function" then fnNew = w2 end
        end
        mt.__index = fnIdx
        mt.__newindex = fnNew
        local oldNamecall = mt.__namecall
        if type(oldNamecall) == "function" and has_getnamecallmethod then
            local fnName = function(self, ...)
                local method = getnamecallmethod()
                if method == "FireServer" then
                    local args = { ... }
                    for _, arg in ipairs(args) do
                        if type(arg) == "table" then
                            if arg.speed or arg.walkspeed or arg.velocity or arg.pos or arg.position
                               or arg.movement or arg.move or arg.offset then return end
                        elseif type(arg) == "Vector3" then
                            if arg.Magnitude > 50 then return end
                        end
                    end
                end
                return oldNamecall(self, ...)
            end
            if has_newcclosure then
                local ok3, w3 = pcall(function() return newcclosure(fnName) end)
                if ok3 and type(w3) == "function" then fnName = w3 end
            end
            mt.__namecall = fnName
        end
        setreadonly(mt, true)
        hookInstalled = true
    end)
end

local function severRemotes()
    if not has_getconnections then return end
    local roots = {
        game:GetService("ReplicatedStorage"),
        game:GetService("ReplicatedFirst"),
        LP,
        LP:FindFirstChild("PlayerScripts"),
        game:GetService("StarterPlayer"),
        workspace,
    }
    for _, root in ipairs(roots) do
        if root then
            local ok, desc = pcall(function() return root:GetDescendants() end)
            if ok and type(desc) == "table" then
                for _, obj in ipairs(desc) do
                    local okISA = pcall(function()
                        return obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") or obj:IsA("BindableEvent") or obj:IsA("BindableFunction")
                    end)
                    if okISA and isAntiCheatRelated(obj) then
                        for _, ev in ipairs({ "OnClientEvent", "OnServerEvent", "Event", "Invoke" }) do
                            local okc, cons = pcall(function() return getconnections(obj[ev]) end)
                            if okc and type(cons) == "table" then
                                for _, c in ipairs(cons) do
                                    pcall(function() c:Disconnect() end)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

