function Library:AddItem(name, cb)
    local displayName = name
    if NameCount[name] then
        NameCount[name] = NameCount[name] + 1
        displayName = NameCount[name] .. ". " .. name
    else
        NameCount[name] = 1
        displayName = "1. " .. name
    end
    local item = {}
    item.Name = displayName
    item.Callback = cb
    item.Frame = Instance.new("Frame")
    item.Frame.Size = UDim2.new(1, -4, 0, 24)
    item.Frame.BackgroundColor3 = COLOR.ItemBg
    item.Frame.BackgroundTransparency = COLOR.ItemTrans
    item.Frame.Parent = ListContainer
    applyCorner(item.Frame, 4)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = "  " .. displayName
    btn.TextColor3 = COLOR.TextMain
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Font = Enum.Font.Antique
    btn.AutoButtonColor = false
    btn.Parent = item.Frame
    btn.MouseEnter:Connect(function()
        tween(item.Frame, { BackgroundColor3 = COLOR.ItemHover, BackgroundTransparency = COLOR.ItemHoverT }, 0.15)
        tween(btn, { TextColor3 = Color3.fromRGB(255, 255, 255) }, 0.15)
    end)
    btn.MouseLeave:Connect(function()
        tween(item.Frame, { BackgroundColor3 = COLOR.ItemBg, BackgroundTransparency = COLOR.ItemTrans }, 0.15)
        tween(btn, { TextColor3 = COLOR.TextMain }, 0.15)
    end)
    btn.MouseButton1Click:Connect(function()
        tween(item.Frame, { BackgroundColor3 = COLOR.ItemPress, BackgroundTransparency = COLOR.ItemPressT }, 0.08)
        task.delay(0.15, function()
            tween(item.Frame, { BackgroundColor3 = COLOR.ItemBg, BackgroundTransparency = COLOR.ItemTrans }, 0.25)
        end)
        if cb then cb() end
    end)
    Items[displayName] = item
    return item
end

function Library:Search(q)
    q = q:lower()
    for _, item in pairs(Items) do
        local m = (q == "" or item.Name:lower():find(q)) and true or false
        item.Frame.Visible = m
    end
    ClearBtn.Visible = q ~= ""
end

