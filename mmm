-- ============================================================
-- 平滑 CFrame 移动模块（原始版）
-- 速度 < 65 正常走路；速度 >= 65 WalkSpeed 归零，全靠 CFrame 插值
-- 含网络抖动 + 帧率补偿，无方向抖动
-- ============================================================
local SmoothMove = {}

local SM = {
    speed = 80,
    enabled = false,
    humanoid = nil,
    root = nil,
    shadowPos = nil,
    walkSpeedZeroed = false,
    originalWalkSpeed = 16,
    walkAnimTrack = nil,
    animatorRef = nil,
}

local WALK_THRESHOLD = 65
local NORMAL_WALKSPEED = 16
local UI_MIN, UI_MAX = 5, 500
local SPEED_STEP = 5
local SMOOTH_FACTOR = 0.92
local LERP_FACTOR = 0.35
local JITTER_MIN = 0.98
local JITTER_MAX = 1.02
local NETWORK_LAG_CHANCE = 0.12
local NETWORK_LAG_MIN = 0.4
local NETWORK_LAG_MAX = 0.7
local TARGET_FRAME_TIME = 1 / 60
local FRAME_COMP_MIN = 0.6
local FRAME_COMP_MAX = 1.4

local function isGrounded()
    if not SM.humanoid then return false end
    local ok, st = pcall(function() return SM.humanoid:GetState() end)
    if not ok or not st then return false end
    return st == Enum.HumanoidStateType.Running
        or st == Enum.HumanoidStateType.RunningNoPhysics
        or st == Enum.HumanoidStateType.Landed
        or st == Enum.HumanoidStateType.Seated
end

local function isSensitive()
    if not SM.humanoid or not SM.humanoid.Parent then return true end
    local ok, st = pcall(function() return SM.humanoid:GetState() end)
    if ok and st then
        if st == Enum.HumanoidStateType.Physics
            or st == Enum.HumanoidStateType.Ragdoll
            or st == Enum.HumanoidStateType.FallingDown
            or st == Enum.HumanoidStateType.PlatformStanding then
            return true
        end
    end
    if SM.humanoid.Sit or SM.humanoid.PlatformStand then return true end
    return false
end

local function findWalkAnimation(char)
    local animate = char:FindFirstChild("Animate")
    if not animate then return nil end
    local walk = animate:FindFirstChild("walk")
    if walk then
        local walkAnim = walk:FindFirstChild("WalkAnim")
        if walkAnim then return walkAnim end
    end
    return nil
end

local function startWalkAnimation()
    if SM.walkAnimTrack and SM.walkAnimTrack.IsPlaying then return end
    if not SM.humanoid then return end
    if not SM.animatorRef then
        SM.animatorRef = SM.humanoid:FindFirstChildOfClass("Animator")
        if not SM.animatorRef then
            SM.animatorRef = Instance.new("Animator")
            SM.animatorRef.Parent = SM.humanoid
        end
    end
    local char = SM.humanoid.Parent
    if not char then return end
    local walkAnim = findWalkAnimation(char)
    if not walkAnim or not walkAnim:IsA("Animation") then return end
    local ok, track = pcall(function()
        return SM.animatorRef:LoadAnimation(walkAnim)
    end)
    if ok and track then
        SM.walkAnimTrack = track
        pcall(function()
            track.Priority = Enum.AnimationPriority.Core
            track.Looped = true
            track:Play(0.1, 1, 1)
        end)
    end
end

local function stopWalkAnimation()
    if SM.walkAnimTrack then
        pcall(function() SM.walkAnimTrack:Stop(0.1) end)
        SM.walkAnimTrack = nil
    end
end

local function setWalkSpeedZero(zero)
    if not SM.humanoid or not SM.humanoid.Parent then return end
    if zero and not SM.walkSpeedZeroed then
        pcall(function()
            SM.originalWalkSpeed = SM.humanoid.WalkSpeed
            SM.humanoid.WalkSpeed = 0
        end)
        SM.walkSpeedZeroed = true
        startWalkAnimation()
    elseif not zero and SM.walkSpeedZeroed then
        pcall(function()
            SM.humanoid.WalkSpeed = SM.originalWalkSpeed > 0 and SM.originalWalkSpeed or NORMAL_WALKSPEED
        end)
        SM.walkSpeedZeroed = false
        stopWalkAnimation()
    end
end

local function frameCompensation(dt)
    if dt <= 0 then return 1.0 end
    local ratio = TARGET_FRAME_TIME / dt
    return math.clamp(ratio, FRAME_COMP_MIN, FRAME_COMP_MAX)
end

local function networkLagMultiplier()
    if math.random() < NETWORK_LAG_CHANCE then
        return NETWORK_LAG_MIN + math.random() * (NETWORK_LAG_MAX - NETWORK_LAG_MIN)
    end
    return 1.0
end

local function smoothMove(dt)
    local hum, root = SM.humanoid, SM.root
    if not root or not root.Parent or not hum or not hum.Parent then return end
    if hum.Health <= 0 then return end

    if SM.speed < WALK_THRESHOLD then
        setWalkSpeedZero(false)
        SM.shadowPos = nil
        return
    end

    setWalkSpeedZero(true)

    if isSensitive() then
        stopWalkAnimation()
        SM.shadowPos = nil
        return
    end

    local mv = hum.MoveDirection
    if mv.Magnitude <= 0.01 then
        stopWalkAnimation()
        SM.shadowPos = nil
        return
    end

    if not isGrounded() then
        stopWalkAnimation()
        SM.shadowPos = nil
        return
    end

    startWalkAnimation()

    local dir = Vector3.new(mv.X, 0, mv.Z)
    if dir.Magnitude < 0.01 then return end
    dir = dir.Unit

    local baseStep = SM.speed * dt
    local speedJitter = JITTER_MIN + math.random() * (JITTER_MAX - JITTER_MIN)
    local step = baseStep * speedJitter
    step = step * frameCompensation(dt)
    step = step * networkLagMultiplier()

    if not SM.shadowPos then
        SM.shadowPos = root.Position
    end

    local realPos = root.Position
    if (SM.shadowPos - realPos).Magnitude > 5 then
        SM.shadowPos = realPos
    end

    local applyStep = step * SMOOTH_FACTOR
    local targetPos = SM.shadowPos + dir * applyStep

    local delta = targetPos - realPos
    if delta.Magnitude > 35 then
        targetPos = realPos + delta.Unit * 35
    end

    SM.shadowPos = SM.shadowPos:Lerp(targetPos, LERP_FACTOR + (1 - LERP_FACTOR) * SMOOTH_FACTOR)

    local finalPos = SM.shadowPos
    local flat = Vector3.new(dir.X, 0, dir.Z)
    local look = flat.Magnitude > 0.01
        and CFrame.lookAt(Vector3.new(), flat)
        or root.CFrame.Rotation

    pcall(function()
        root.CFrame = CFrame.new(finalPos) * look
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function bindChar(char)
    if not char then return end
    task.spawn(function()
        SM.humanoid = char:WaitForChild("Humanoid", 5)
        SM.root = char:WaitForChild("HumanoidRootPart", 5)
        SM.walkSpeedZeroed = false
        SM.walkAnimTrack = nil
        SM.animatorRef = nil
        SM.shadowPos = nil
        SM.originalWalkSpeed = SM.humanoid and SM.humanoid.WalkSpeed or NORMAL_WALKSPEED
    end)
end

if localPlayer.Character then bindChar(localPlayer.Character) end
localPlayer.CharacterAdded:Connect(bindChar)
localPlayer.CharacterRemoving:Connect(function()
    stopWalkAnimation()
    SM.walkSpeedZeroed = false
    SM.shadowPos = nil
end)

RunService.RenderStepped:Connect(function(dt)
    if not SM.enabled then
        if SM.walkSpeedZeroed then setWalkSpeedZero(false) end
        return
    end
    if not SM.humanoid or not SM.humanoid.Parent or not SM.root or not SM.root.Parent then
        if SM.walkSpeedZeroed then setWalkSpeedZero(false) end
        return
    end
    smoothMove(dt)
end)

function SmoothMove.setSpeed(v)
    v = tonumber(v) or 80
    v = math.clamp(math.floor(v / SPEED_STEP + 0.5) * SPEED_STEP, UI_MIN, UI_MAX)
    SM.speed = v
    SM.enabled = v > 16
    if not SM.enabled and SM.walkSpeedZeroed then
        setWalkSpeedZero(false)
    end
end

function SmoothMove.getSpeed()
    return SM.speed
end

function SmoothMove.stop()
    SM.enabled = false
