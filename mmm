SafeRun("Enhance.AntiKnockbackPlus", function()
    local tracked = setmetatable({}, { __mode = "k" })
    local conns = {}
    local lastGrace = 0
    local graceActive = false

    local function processHumanoid(hum)
        if not hum or tracked[hum] then return end
        tracked[hum] = true
        pcall(function()
            hum.BreakJointsOnDeath = false
            hum.RequiresNeck = false
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
        end)
    end

    local function processCharacter(char)
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then processHumanoid(hum) end
        for _, d in ipairs(char:GetDescendants()) do
            if (d:IsA("BallSocketConstraint") or d:IsA("HingeConstraint") or d:IsA("RigidConstraint"))
                and tostring(d.Name):find("RagdollConstraint") then
                pcall(function() d:Destroy() end)
            elseif d:IsA("Motor6D") and not d.Enabled then
                pcall(function() d.Enabled = true end)
            end
        end
        table.insert(conns, TrackConn(char.DescendantAdded:Connect(function(d)
            if (d:IsA("BallSocketConstraint") or d:IsA("HingeConstraint") or d:IsA("RigidConstraint"))
                and tostring(d.Name):find("RagdollConstraint") then
                task.defer(function()
                    pcall(function()
                        if d and d.Parent then d:Destroy() end
                    end)
                end)
            elseif d:IsA("Motor6D") and not d.Enabled then
                task.defer(function()
                    pcall(function()
                        if d and d.Parent then d.Enabled = true end
                    end)
                end)
            end
        end)))
    end

    pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        local Remotes = nil
        pcall(function() Remotes = require(rs.Shared.Remotes) end)
        if not Remotes then
            pcall(function() Remotes = require(rs:FindFirstChild("Shared"):FindFirstChild("Remotes")) end)
        end
        if Remotes and Remotes.RigSync and Remotes.RigSync.Refresh then
            local sig = Remotes.RigSync.Refresh.OnClientEvent
            table.insert(conns, TrackConn(sig:Connect(function(payload)
                if type(payload) ~= "string" then return end
                local ok, decoded = pcall(function()
                    return game:GetService("HttpService"):JSONDecode(payload)
                end)
                if not ok or type(decoded) ~= "table" then return end
                local action = decoded.Action
                if action == "BeginRagdoll" or action == "BeginImpulse" then
                    graceActive = true
                    lastGrace = os.clock() + 1.5
                end
            end)))
        end
    end)

    TrackConn(localPlayer:GetAttributeChangedSignal("RagdollEndTime"):Connect(function()
        local n = tonumber(localPlayer:GetAttribute("RagdollEndTime"))
        if n and n > workspace:GetServerTimeNow() then
            graceActive = true
            lastGrace = os.clock() + 2.0
        end
    end))

    TrackConn(localPlayer.CharacterAdded:Connect(function(c)
        task.defer(processCharacter, c)
    end))
    if localPlayer.Character then task.defer(processCharacter, localPlayer.Character) end

    TrackThread(task.spawn(function()
        while XDG_MEM.Alive do
            local c = localPlayer.Character
            if c then processCharacter(c) end
            if graceActive and os.clock() > lastGrace then graceActive = false end
            task.wait(0.1)
        end
    end))

    pcall(function()
        local env = getgenv and getgenv() or _G
        env.XDG_AntiKnockback = {
            isGrace = function() return graceActive end,
            graceUntil = function() return lastGrace end,
        }
    end)
end)

SafeRun("Enhance.HumanoidSwap", function()
    local swapState = { original = nil, clone = nil, active = false }

    local function chilliShieldActive()
        if tbl4 and type(tbl4.Swapped) == "function" then
            local ok, r = pcall(tbl4.Swapped)
            if ok and r == true then return true end
        end
        return false
    end

    local function trySwap()
        if swapState.active then return true end
        if chilliShieldActive() then return false end
        local char = localPlayer.Character
        if not char then return false end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp then return false end
        if hum:GetAttribute("__XDGSwap") then return true end

        local archivable = char.Archivable
        char.Archivable = true
        local ok, clone = pcall(function() return hum:Clone() end)
        char.Archivable = archivable
        if not ok or not clone then return false end

        local ws = hum.WalkSpeed
        local jp = hum.JumpPower
        local jh = hum.JumpHeight
        local ujp = hum.UseJumpPower
        local hh = hum.HipHeight
        local ar = hum.AutoRotate
        local mh = hum.MaxHealth
        local h = hum.Health

        clone.Name = "Humanoid"
        clone:SetAttribute("__XDGSwap", true)
        clone.Parent = char
        hum:Destroy()

        clone.WalkSpeed = ws
        clone.JumpPower = jp
        clone.JumpHeight = jh
        clone.UseJumpPower = ujp
        clone.HipHeight = hh
        clone.AutoRotate = ar
        clone.MaxHealth = mh
        clone.Health = math.min(h, mh)

        for _, st in ipairs(Enum.HumanoidStateType:GetEnumItems()) do
            pcall(function() clone:SetStateEnabled(st, true) end)
        end

        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)

        local cam = workspace.CurrentCamera
        if cam then
            cam.CameraType = Enum.CameraType.Custom
            cam.CameraSubject = clone
        end

        local animate = char:FindFirstChild("Animate")
        if animate then
            animate.Disabled = true
            task.wait()
            animate.Disabled = false
        end

        task.defer(function()
            if clone.Parent then
                pcall(function() clone:ChangeState(Enum.HumanoidStateType.Running) end)
            end
        end)

        swapState.original = hum
        swapState.clone = clone
        swapState.active = true
        return true
    end

    local function undoSwap()
        if not swapState.active then return end
        local char = localPlayer.Character
        local orig = swapState.original
        local cl = swapState.clone
        if orig and cl and char and orig.Parent == nil and cl.Parent == char then
            pcall(function()
                orig.Parent = char
                cl:Destroy()
            end)
        end
        swapState.original = nil
        swapState.clone = nil
        swapState.active = false
    end

    TrackConn(localPlayer.CharacterAdded:Connect(function()
        swapState.active = false
        swapState.original = nil
        swapState.clone = nil
    end))

    TrackThread(task.spawn(function()
        while XDG_MEM.Alive do
            local c = localPlayer.Character
            if c then
                local hum = c:FindFirstChildOfClass("Humanoid")
                if hum and not hum:GetAttribute("__XDGSwap") and not chilliShieldActive() then
                    pcall(trySwap)
                end
            end
            task.wait(0.2)
        end
    end))

    pcall(function()
        local env = getgenv and getgenv() or _G
        env.XDG_HumanoidSwap = {
            enable = trySwap,
            disable = undoSwap,
            isActive = function() return swapState.active end,
        }
    end)
end)

SafeRun("Enhance.FreezePosition", function()
    local state = { enabled = false, targetPos = nil, originalAnchored = nil }

    local function isAntiKnockGrace()
        if getgenv and getgenv().XDG_AntiKnockback and getgenv().XDG_AntiKnockback.isGrace then
            local ok, r = pcall(getgenv().XDG_AntiKnockback.isGrace)
            if ok and r == true then return true end
        end
        return false
    end

    local function anchorRoot(hrp)
        if not hrp then return end
        if state.originalAnchored == nil then
            state.originalAnchored = hrp.Anchored
        end
        pcall(function()
            hrp.Anchored = true
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    local function restoreAnchor(hrp)
        if not hrp then return end
        if state.originalAnchored ~= nil then
            pcall(function() hrp.Anchored = state.originalAnchored end)
            state.originalAnchored = nil
        end
    end

    TrackConn(RunService.Heartbeat:Connect(function()
        if not state.enabled or not state.targetPos then return end
        if isAntiKnockGrace() then
            restoreAnchor(localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart"))
            return
        end
        local char = localPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        anchorRoot(hrp)
        pcall(function()
            local rot = hrp.CFrame.Rotation
            hrp.CFrame = CFrame.new(state.targetPos) * rot
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
    end))

    TrackConn(localPlayer.CharacterRemoving:Connect(function()
        state.enabled = false
        state.targetPos = nil
        state.originalAnchored = nil
    end))

    pcall(function()
        local env = getgenv and getgenv() or _G
        env.XDG_Freeze = {
            set = function(pos, on)
                if typeof(pos) == "Vector3" then state.targetPos = pos end
                state.enabled = (on ~= false) and state.targetPos ~= nil
            end,
            setHere = function()
                local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    state.targetPos = hrp.Position
                    state.enabled = true
                end
            end,
            clear = function()
                state.enabled = false
                state.targetPos = nil
                restoreAnchor(localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart"))
            end,
            isActive = function() return state.enabled end,
            getPos = function() return state.targetPos end,
        }
    end)
end)

