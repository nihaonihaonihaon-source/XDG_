-- Humanoid 替换绕过
-- ============================================================
pcall(function()
    local Players = game:GetService("Players")
    local localPlayer = Players.LocalPlayer
    local function replaceHumanoid(character)
        local oldHum = character:FindFirstChildOfClass("Humanoid")
        if not oldHum then return end
        local cam = workspace.CurrentCamera
        local animate = character:FindFirstChild("Animate")
        local ws = oldHum.WalkSpeed
        local jp = oldHum.JumpPower
        local jh = oldHum.JumpHeight
        local hp = oldHum.Health
        local mhp = oldHum.MaxHealth
        if animate and animate:IsA("LocalScript") then animate.Disabled = true end
        local anim = oldHum:FindFirstChildOfClass("Animator")
        if anim then
            for _, track in next, anim:GetPlayingAnimationTracks() do
                track:Stop(0)
            end
        end
        oldHum.Archivable = true
        local clone = oldHum:Clone()
        for _, child in next, clone:GetChildren() do
            if child:IsA("Animator") then child:Destroy() end
        end
        oldHum.Name = "_OldHumanoid"
        clone.Name = "Humanoid"
        clone.Parent = character
        local newAnim = Instance.new("Animator")
        newAnim.Parent = clone
        clone.WalkSpeed = ws
        clone.JumpPower = jp
        clone.JumpHeight = jh
        clone.MaxHealth = mhp
        clone.Health = math.min(hp, mhp)
        if cam then cam.CameraSubject = clone end
        oldHum:Destroy()
        if animate and animate:IsA("LocalScript") then
            task.wait()
            animate.Disabled = false
            task.defer(function()
                if animate.Parent then
                    animate.Disabled = true
                    task.wait()
                    animate.Disabled = false
                end
            end)
        end
        task.defer(function()
            if clone.Parent then
                clone:ChangeState(Enum.HumanoidStateType.Running)
            end
        end)
        return clone
    end
    local function onCharacter(char)
        char:WaitForChild("Humanoid")
        task.wait()
        replaceHumanoid(char)
    end
    if localPlayer.Character then task.spawn(onCharacter, localPlayer.Character) end
    localPlayer.CharacterAdded:Connect(function(char)
        task.spawn(onCharacter, char)
    end)
    print("[XDG-Humanoid] Humanoid 替换绕过已启动")
end)

