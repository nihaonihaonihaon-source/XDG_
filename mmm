                    h.Transparency = 1
                    h.CanCollide = false
                    h.CanTouch = false
                    h.CanQuery = false
                    h.Massless = true
                    h.Parent = char
                end)
            end
        end)))
        table.insert(HeadConns, TrackConn(RunService.Heartbeat:Connect(function()
            if not char or not char.Parent then return end
            local h = char:FindFirstChild("Head")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if h and hrp and h:IsA("BasePart") and h.Transparency >= 1 then
                pcall(function() h.CFrame = hrp.CFrame * CFrame.new(0,1.5,0) end)
            end
        end)))
    end
    local function FreezeHum(char)
        local hum = char:FindFirstChildOfClass("Humanoid")
