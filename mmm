local SmoothMoveAPI = {}

SafeRun("XDG.SmoothMove", function()
    local CAP = {
        getrawmetatable = type(getrawmetatable) == "function",
        setreadonly = type(setreadonly) == "function",
    }

    local UI_MIN, UI_MAX = 5, 500
    local TARGET_SPEED = 80
    local SPEED_STEP = 5
    local WALK_THRESHOLD = 65
    local NORMAL_WALKSPEED = 16

    -- 平滑参数 v4：更平滑
    local SMOOTH_FACTOR = 0.92      -- 0.92 → 每帧位移只有目标值的 92%，剩下 8% 用 lerp 分摊
    local LERP_FACTOR = 0.35        -- 剩余位移用 lerp 分摊的比例
    local JITTER_MIN = 0.98
    local JITTER_MAX = 1.02
    local USE_RENDERSTEPPED = true

    local SP = false
    local US = TARGET_SPEED
    local CH = nil
    local CR = nil
    local HI = false
    local ORI = {}
    local SPF = {WalkSpeed=16, JumpPower=50, JumpHeight=7.2, HipHeight=2}
    local originalWalkSpeed = NORMAL_WALKSPEED
    local walkSpeedZeroed = false

    local walkAnimTrack = nil
    local animatorRef = nil

    -- 平滑位移的"影子位置"
    local shadowPos = nil

    local function IsGrounded()
        if not CH then return false end
        local ok, st = pcall(function() return CH:GetState() end)
        if not ok or not st then return false end
        return st == Enum.HumanoidStateType.Running
            or st == Enum.HumanoidStateType.RunningNoPhysics
            or st == Enum.HumanoidStateType.Landed
            or st == Enum.HumanoidStateType.Seated
    end

    local function IsSensitive()
        if not CH or not CH.Parent then return true end
        local ok, st = pcall(function() return CH:GetState() end)
        if ok and st then
            if st == Enum.HumanoidStateType.Physics
                or st == Enum.HumanoidStateType.Ragdoll
                or st == Enum.HumanoidStateType.FallingDown
                or st == Enum.HumanoidStateType.PlatformStanding then
                return true
            end
        end
        if CH.Sit or CH.PlatformStand then return true end
        return false
    end

    local function FindWalkAnimation(char)
        local animate = char:FindFirstChild("Animate")
        if not animate then return nil end
        local walk = animate:FindFirstChild("walk")
        if walk then
            local walkAnim = walk:FindFirstChild("WalkAnim")
            if walkAnim then return walkAnim end
        end
        return nil
    end

    local function StartWalkAnimation()
        if walkAnimTrack and walkAnimTrack.IsPlaying then return end
        if not CH then return end

        if not animatorRef then
            animatorRef = CH:FindFirstChildOfClass("Animator")
            if not animatorRef then
                animatorRef = Instance.new("Animator")
                animatorRef.Parent = CH
            end
        end

        local char = CH.Parent
        if not char then return end

        local walkAnim = FindWalkAnimation(char)
        if not walkAnim or not walkAnim:IsA("Animation") then return end

        local ok, track = pcall(function()
            return animatorRef:LoadAnimation(walkAnim)
        end)

        if ok and track then
            walkAnimTrack = track
            pcall(function()
                track.Priority = Enum.AnimationPriority.Core
                track.Looped = true
                track:Play(0.1, 1, 1)
            end)
        end
    end

    local function StopWalkAnimation()
        if walkAnimTrack then
            pcall(function()
                walkAnimTrack:Stop(0.1)
            end)
            walkAnimTrack = nil
        end
    end

    local function SetWalkSpeedZero(zero)
        if not CH or not CH.Parent then return end
        if zero and not walkSpeedZeroed then
            pcall(function()
                originalWalkSpeed = CH.WalkSpeed
                CH.WalkSpeed = 0
            end)
            walkSpeedZeroed = true
            StartWalkAnimation()
        elseif not zero and walkSpeedZeroed then
            pcall(function()
                CH.WalkSpeed = originalWalkSpeed > 0 and originalWalkSpeed or NORMAL_WALKSPEED
            end)
            walkSpeedZeroed = false
            StopWalkAnimation()
        end
    end

    local function InstallMetahook()
        if HI then return end
        if not (CAP.getrawmetatable and CAP.setreadonly) then return end
        local m = getrawmetatable(game)
        if type(m) ~= "table" then return end
        if not ORI.__index then
            ORI.__index = m.__index
            ORI.__newindex = m.__newindex
        end
        setreadonly(m, false)
        local oi = m.__index
        local on = m.__newindex
        if type(oi) ~= "function" or type(on) ~= "function" then
            setreadonly(m, true)
            return
        end
        local fi = function(s, k)
            if s ~= CH and s ~= CR then return oi(s, k) end
            if CH and s == CH and SPF[k] then
                if k == "WalkSpeed" and walkSpeedZeroed then
                    return originalWalkSpeed > 0 and originalWalkSpeed or NORMAL_WALKSPEED
                end
                local ok, v = pcall(oi, s, k)
                if ok and v ~= nil then return v end
                return SPF[k]
            end
            return oi(s, k)
        end
        local fn = function(s, k, v)
            if CH and s == CH and SPF[k] then return end
            return on(s, k, v)
        end
        m.__index = fi
        m.__newindex = fn
        ORI.__index = m.__index
        ORI.__newindex = m.__newindex
        setreadonly(m, true)
        HI = true
    end

    local function SmoothMove(dt)
        if not CR or not CR.Parent or not CH or not CH.Parent then return end
        if CH.Health <= 0 then return end

        if US < WALK_THRESHOLD then
            SetWalkSpeedZero(false)
            shadowPos = nil
            return
        end

        SetWalkSpeedZero(true)

        if IsSensitive() then
            StopWalkAnimation()
            shadowPos = nil
            return
        end

        local mv = CH.MoveDirection
        local isMoving = mv.Magnitude > 0.01

        if not isMoving then
            StopWalkAnimation()
            shadowPos = nil
            return
        end

        if not IsGrounded() then
            StopWalkAnimation()
            shadowPos = nil
            return
        end

        StartWalkAnimation()

        local dir = Vector3.new(mv.X, 0, mv.Z)
        if dir.Magnitude < 0.01 then return end
        dir = dir.Unit

        -- 计算本帧应移动的距离
        local baseStep = US * dt
        local jitter = JITTER_MIN + math.random() * (JITTER_MAX - JITTER_MIN)
        local step = baseStep * jitter

        -- 初始化影子位置
        if not shadowPos then
            shadowPos = CR.Position
        end

        -- 影子位置向实际位置同步（防止无限漂移）
        local realPos = CR.Position
        if (shadowPos - realPos).Magnitude > 5 then
            shadowPos = realPos
        end

        -- 每帧只移动 step * SMOOTH_FACTOR 的距离
        local applyStep = step * SMOOTH_FACTOR
        local targetPos = shadowPos + dir * applyStep

        -- 用 lerp 把影子和实际位置"黏合"，让过渡更连续
        shadowPos = shadowPos:Lerp(targetPos, LERP_FACTOR + (1 - LERP_FACTOR) * SMOOTH_FACTOR)

        local finalPos = shadowPos

        local flat = Vector3.new(dir.X, 0, dir.Z)
        local look = flat.Magnitude > 0.01
            and CFrame.lookAt(Vector3.new(), flat)
            or CR.CFrame.Rotation

        pcall(function()
            CR.CFrame = CFrame.new(finalPos) * look
            CR.AssemblyLinearVelocity = Vector3.zero
            CR.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    local function OnChar(ch)
        if not ch then return end
        TrackThread(task.spawn(function()
            CH = ch:WaitForChild("Humanoid", 5)
            CR = ch:WaitForChild("HumanoidRootPart", 5)
            HI = false
            walkSpeedZeroed = false
            walkAnimTrack = nil
            animatorRef = nil
            shadowPos = nil
            originalWalkSpeed = CH and CH.WalkSpeed or NORMAL_WALKSPEED
            InstallMetahook()
        end))
    end

    if localPlayer.Character then OnChar(localPlayer.Character) end
    TrackConn(localPlayer.CharacterAdded:Connect(OnChar))

    local loopSignal = USE_RENDERSTEPPED and RunService.RenderStepped or RunService.Heartbeat
    TrackConn(loopSignal:Connect(function(dt)
        pcall(function()
            if not SP then
                if walkSpeedZeroed then SetWalkSpeedZero(false) end
                return
            end
            if not CH or not CH.Parent or not CR or not CR.Parent then
                if walkSpeedZeroed then SetWalkSpeedZero(false) end
                return
            end
            SmoothMove(dt)
        end)
    end))

    TrackConn(localPlayer.CharacterRemoving:Connect(function()
        StopWalkAnimation()
        walkSpeedZeroed = false
        shadowPos = nil
    end))

    local function SetSpeed(v)
        v = tonumber(v) or TARGET_SPEED
        v = math.clamp(math.floor(v / SPEED_STEP + 0.5) * SPEED_STEP, UI_MIN, UI_MAX)
        US = v
        SP = US > 16
        if not SP and walkSpeedZeroed then
            SetWalkSpeedZero(false)
        end
        pcall(function()
            warn("[XDG-Speed] 速度 " .. US .. "（" .. (US >= WALK_THRESHOLD and "CFrame 模式" or "正常走路") .. "）")
        end)
    end

    SmoothMoveAPI.setSpeed = SetSpeed
    SmoothMoveAPI.getSpeed = function() return US end
    SmoothMoveAPI.setSmoothFactor = function(v)
        SMOOTH_FACTOR = math.clamp(tonumber(v) or 0.92, 0.05, 1.0)
    end
    SmoothMoveAPI.setLerpFactor = function(v)
        LERP_FACTOR = math.clamp(tonumber(v) or 0.35, 0.05, 1.0)
    end
    SmoothMoveAPI.setJitter = function(minv, maxv)
        JITTER_MIN = math.max(0.5, tonumber(minv) or 0.98)
        JITTER_MAX = math.min(2.0, tonumber(maxv) or 1.02)
    end
    SmoothMoveAPI.setLoop = function(useRender)
        USE_RENDERSTEPPED = useRender == true
    end
    SmoothMoveAPI.getMode = function()
        return US >= WALK_THRESHOLD and "CFrame" or "Walk"
    end
    SmoothMoveAPI.isWalkAnimPlaying = function()
        return walkAnimTrack ~= nil and walkAnimTrack.IsPlaying == true
    end

    SetSpeed(TARGET_SPEED)

    pcall(function()
        local env = getgenv and getgenv() or _G
        env.XDG_SmoothMove = SmoothMoveAPI
    end)
end)

