local dragStart, dragStartPos, dragging = nil, nil, false
local BOUNDARY_MARGIN = 30
local function getViewportSize()
    local cam = workspace.CurrentCamera
    if cam then return cam.ViewportSize end
    return Vector2.new(1920,1080)
end
local function clampPosition(pos)
    local vp = getViewportSize()
    local fw = MainFrame.AbsoluteSize.X
    local fh = MainFrame.AbsoluteSize.Y
    if fw == 0 then fw = 250 end
    if fh == 0 then fh = 280 end
    local minX = -(fw - BOUNDARY_MARGIN)
    local maxX = vp.X - BOUNDARY_MARGIN
    local minY = 0
    local maxY = vp.Y - BOUNDARY_MARGIN
    return UDim2.new(0, math.clamp(pos.X.Offset, minX, maxX), 0, math.clamp(pos.Y.Offset, minY, maxY))
end
