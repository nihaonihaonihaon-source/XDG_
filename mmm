                if type(d) == "function" and not detected then detected = d end
                if rawget(v, "Variables") and rawget(v, "Process") then
                    local k = rawget(v, "Kill")
                    if type(k) == "function" and not killfunc then killfunc = k end
                end
            end
        end
        if detected then pcall(function() hookfunction(detected, function() return true end) end) end
        if killfunc then pcall(function() hookfunction(killfunc, function() end) end) end
