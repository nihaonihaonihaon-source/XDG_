function Library:AddItem(n, cb)
    local dn = n
    if NameCount[n] then
        NameCount[n] = NameCount[n] + 1
        dn = NameCount[n] .. ". " .. n
    else
        NameCount[n] = 1
        dn = "1. " .. n
    end
    local it = {}
    it.Name = dn
    it.Callback = cb
    it.Frame = Instance.new("Frame")
    it.Frame.Size = UDim2.new(1,-4,0,24)
    it.Frame.BackgroundColor3 = COLOR.ItemBg
    it.Frame.BackgroundTransparency = COLOR.ItemTrans
    it.Frame.Parent = ListContainer
    applyCorner(it.Frame, 4)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1,0,1,0)
    btn.BackgroundTransparency = 1
    btn.Text = "  " .. dn
    btn.TextColor3 = COLOR.TextMain
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Font = Enum.Font.Antique
    btn.AutoButtonColor = false
    btn.Parent = it.Frame
    btn.MouseEnter:Connect(function()
        tween(it.Frame, { BackgroundColor3 = COLOR.ItemHover, BackgroundTransparency = COLOR.ItemHoverT }, 0.15)
        tween(btn, { TextColor3 = Color3.fromRGB(255,255,255) }, 0.15)
    end)
    btn.MouseLeave:Connect(function()
        tween(it.Frame, { BackgroundColor3 = COLOR.ItemBg, BackgroundTransparency = COLOR.ItemTrans }, 0.15)
        tween(btn, { TextColor3 = COLOR.TextMain }, 0.15)
    end)
    btn.MouseButton1Click:Connect(function()
        tween(it.Frame, { BackgroundColor3 = COLOR.ItemPress, BackgroundTransparency = COLOR.ItemPressT }, 0.08)
        task.delay(0.15, function()
            tween(it.Frame, { BackgroundColor3 = COLOR.ItemBg, BackgroundTransparency = COLOR.ItemTrans }, 0.25)
        end)
        if cb then cb() end
    end)
    Items[dn] = it
    return it
end
function Library:Search(q)
    q = q:lower()
    for _, it in pairs(Items) do
        local m = false
        if q == "" then m = true
        elseif it.Name:lower():find(q) then m = true end
        it.Frame.Visible = m
    end
    ClearBtn.Visible = q ~= ""
end
