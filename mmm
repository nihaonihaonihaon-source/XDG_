    end))
    TrackConn(UserInputService.InputChanged:Connect(function(inp)
        if sliding and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
            updFromInput(inp)
        end
    end))
    TrackConn(minus.MouseButton1Click:Connect(function() setVal(fn.value - (fn.step or 1)) end))
    TrackConn(plus.MouseButton1Click:Connect(function() setVal(fn.value + (fn.step or 1)) end))
    upd()
    return {
        card = card,
        setVal = setVal,
        getVal = function() return fn.value end,
        onChange = function(cb) fn.cb = cb end,
        config = fn,
    }
end

