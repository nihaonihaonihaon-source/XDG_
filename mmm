        curLbl.Text = tostring(fn.value) .. "/" .. tostring(fn.default)
    end
    local function setVal(v)
        v = tonumber(v) or fn.value
        local step = fn.step or 1
        v = math.floor(v / step + 0.5) * step
        v = math.clamp(v, fn.min, fn.max)
        fn.value = v
        upd()
        if fn.cb then pcall(fn.cb, v) end
    end
    local sliding = false
    local function updFromInput(inp)
        local rel = inp.Position.X - barBg.AbsolutePosition.X
        local pct = math.clamp(rel / barBg.AbsoluteSize.X, 0, 1)
        setVal(fn.min + pct * (fn.max - fn.min))
