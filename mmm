-- ============================================================
-- 注册表
-- ============================================================
genv.XDG_REG_KEY_2026 = genv.XDG_REG_KEY_2026 or {}
local REG = genv.XDG_REG_KEY_2026
REG.Scripts = REG.Scripts or {}
REG.Logs = REG.Logs or {}
REG.Listeners = REG.Listeners or {}
REG.LogListeners = REG.LogListeners or {}
function REG:Insert(n, u)
    if not n or n == "" then return end
    for _, s in ipairs(self.Scripts) do
        if s.name == n then if u and s.url ~= u then s.url = u end return end
    end
    table.insert(self.Scripts, { name = n, url = u or "" })
    for _, cb in ipairs(self.Listeners) do pcall(cb, n, u) end
end
function REG:InsertBatch(d)
    if type(d) ~= "string" then return end
    for l in d:gmatch("[^\n]+") do
        local n, u = l:match("^(.-)|(.*)$")
        if n and u and n ~= "" then self:Insert(n, u) end
    end
end
function REG:InsertLog(d, s)
    if not d then return end
    for _, l in ipairs(self.Logs) do if l.Date == d then return end end
    table.insert(self.Logs, { Date = d, Scripts = s or {} })
    for _, cb in ipairs(self.LogListeners) do pcall(cb, d, s) end
end
function REG:OnInsert(cb)
    table.insert(self.Listeners, cb)
    for _, s in ipairs(self.Scripts) do pcall(cb, s.name, s.url) end
end
function REG:OnInsertLog(cb)
    table.insert(self.LogListeners, cb)
    for _, l in ipairs(self.Logs) do pcall(cb, l.Date, l.Scripts) end
end

-- ============================================================
-- 内存管理
-- ============================================================
local XDG_MEM = { Connections = {}, Threads = {}, Alive = true }
local function TrackConn(c) if c then table.insert(XDG_MEM.Connections, c) end return c end
local function TrackThread(t) if t then table.insert(XDG_MEM.Threads, t) end return t end
local function SafeDisconnect(c) if c then pcall(function() c:Disconnect() end) end end
local function CleanupAll()
    for i = #XDG_MEM.Connections, 1, -1 do
        SafeDisconnect(XDG_MEM.Connections[i])
        XDG_MEM.Connections[i] = nil
    end
    for i = #XDG_MEM.Threads, 1, -1 do
        pcall(function() task.cancel(XDG_MEM.Threads[i]) end)
        XDG_MEM.Threads[i] = nil
    end
end

-- ============================================================
-- SafeRun
-- ============================================================
local SafeModules = {}
local function SafeRun(name, fn, ...)
    local ok, err = pcall(fn, ...)
    SafeModules[name] = ok and true or false
    if not ok then
        pcall(function()
            warn(string.format("[XDG] %s 跳过: %s", name, tostring(err)))
        end)
    end
    return ok
end

