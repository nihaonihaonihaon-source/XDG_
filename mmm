local SpeedAPIs = {}

SafeRun("XDG.SpeedBypass", function()
    local CAP = {
        getrawmetatable = type(getrawmetatable) == "function",
        setreadonly = type(setreadonly) == "function",
        getnamecallmethod = type(getnamecallmethod) == "function",
    }
    local UI_MIN, UI_MAX = 5, 300
    local TARGET_SPEED = 60
    local SPEED_STEP = 5
    local STOP = 0.01
    local MAX_STEP = 30
    local VEL_LIMIT = 3000
    local LAG_DIST = 5
    local LAG_DOT = -0.5
    local LAG_CD = 1.0
    local SP = false
    local US = TARGET_SPEED
    local CH = nil
    local CR = nil
    local HI = false
    local ORI = {}
    local lastPos = nil
    local lagBackUntil = 0
    local SPF = {WalkSpeed=16, JumpPower=50, JumpHeight=7.2, HipHeight=2}
    local function RS() return math.min(US, MAX_STEP * 60) end
    local function IsGrounded()
        if not CH then return false end
        local ok, st = pcall(function() return CH:GetState() end)
        if not ok or not st then return false end
        return st == Enum.HumanoidStateType.Running
            or st == Enum.HumanoidStateType.RunningNoPhysics
            or st == Enum.HumanoidStateType.Landed
            or st == Enum.HumanoidStateType.Seated
    end
    local function IsSensitive()
        if not CH or not CH.Parent then return true end
        local ok, st = pcall(function() return CH:GetState() end)
        if ok and st then
            if st == Enum.HumanoidStateType.Physics
                or st == Enum.HumanoidStateType.Ragdoll
                or st == Enum.HumanoidStateType.FallingDown
                or st == Enum.HumanoidStateType.PlatformStanding then
                return true
            end
        end
        if CH.Sit or CH.PlatformStand then return true end
        if os.clock() < lagBackUntil then return true end
        return false
    end
    local function DetectLagBack()
        if not CR or not CR.Parent or not CH or not CH.Parent then return end
        local cur = CR.Position
        local mv = CH.MoveDirection
        if not lastPos then lastPos = cur return end
        local delta = cur - lastPos
        local dist = delta.Magnitude
        lastPos = cur
        if dist < LAG_DIST then return end
        if mv.Magnitude < 0.1 then return end
        local dot = delta.Unit:Dot(mv.Unit)
        if dot < LAG_DOT then
            lagBackUntil = os.clock() + LAG_CD
            pcall(function()
                local v0 = CR.AssemblyLinearVelocity
                CR.AssemblyLinearVelocity = Vector3.new(0, v0.Y, 0)
                CR.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end
    local function InstallMetahook()
        if HI then return end
        if not (CAP.getrawmetatable and CAP.setreadonly) then return end
        local m = getrawmetatable(game)
        if type(m) ~= "table" then return end
        if not ORI.__index then
            ORI.__index = m.__index
            ORI.__newindex = m.__newindex
        end
        setreadonly(m, false)
        local oi = m.__index
        local on = m.__newindex
        if type(oi) ~= "function" or type(on) ~= "function" then
            setreadonly(m, true)
            return
        end
        local fi = function(s, k)
            if s ~= CH and s ~= CR then return oi(s, k) end
            if CH and s == CH and SPF[k] then
                local ok, v = pcall(oi, s, k)
                if ok and v ~= nil then return v end
                return SPF[k]
            end
            if CR and s == CR and (k == "Velocity" or k == "AssemblyLinearVelocity") then
                if SP and CH and CH.MoveDirection.Magnitude > 0.1 then
                    local ok, v = pcall(oi, s, k)
                    local y = ok and typeof(v) == "Vector3" and v.Y or 0
                    local d = CH.MoveDirection.Unit
                    return Vector3.new(d.X * 16, y, d.Z * 16)
                end
            end
            return oi(s, k)
        end
        local fn = function(s, k, v)
            if CH and s == CH and SPF[k] then return end
            return on(s, k, v)
        end
        m.__index = fi
        m.__newindex = fn
        ORI.__index = m.__index
        ORI.__newindex = m.__newindex
        setreadonly(m, true)
        HI = true
    end
    local function VerifyMetahook()
        if not CAP.getrawmetatable then return true end
        local ok, m = pcall(getrawmetatable, game)
        if not ok or type(m) ~= "table" then return false end
        if ORI.__index and m.__index ~= ORI.__index then return false end
        if ORI.__newindex and m.__newindex ~= ORI.__newindex then return false end
        return true
    end
    local function PushSpeed()
        if not CR or not CR.Parent or not CH or not CH.Parent then return end
        if CH.Health <= 0 then return end
        if IsSensitive() then return end
        if not IsGrounded() then return end
        local mv = CH.MoveDirection
        if mv.Magnitude < STOP then
            pcall(function()
                local v0 = CR.AssemblyLinearVelocity
                CR.AssemblyLinearVelocity = Vector3.new(0, v0.Y, 0)
                CR.AssemblyAngularVelocity = Vector3.zero
            end)
            return
        end
        local target = RS()
        if target <= 16 then return end
        local dir = Vector3.new(mv.X, 0, mv.Z).Unit
        local cur = CR.AssemblyLinearVelocity
        local goal = Vector3.new(dir.X * target, cur.Y, dir.Z * target)
        if (goal - cur).Magnitude > VEL_LIMIT then return end
        CR.AssemblyLinearVelocity = goal
        CR.AssemblyAngularVelocity = Vector3.zero
    end
    local function OnChar(ch)
        if not ch then return end
        TrackThread(task.spawn(function()
            CH = ch:WaitForChild("Humanoid", 5)
            CR = ch:WaitForChild("HumanoidRootPart", 5)
            HI = false
            lastPos = nil
            lagBackUntil = 0
            InstallMetahook()
        end))
    end
    if localPlayer.Character then OnChar(localPlayer.Character) end
    TrackConn(localPlayer.CharacterAdded:Connect(OnChar))
    TrackConn(RunService.Heartbeat:Connect(function()
        pcall(function()
            if not VerifyMetahook() then
                HI = false
                task.spawn(function() pcall(InstallMetahook) end)
            end
            if not SP then return end
            if not CH or not CH.Parent or not CR or not CR.Parent then return end
            DetectLagBack()
            PushSpeed()
        end)
    end))
    local function SetSpeed(v)
        v = tonumber(v) or TARGET_SPEED
        v = math.clamp(math.floor(v / SPEED_STEP + 0.5) * SPEED_STEP, UI_MIN, UI_MAX)
        US = v
        SP = US > 16
        if not SP and CR and CR.Parent then
            local v0 = CR.AssemblyLinearVelocity
            CR.AssemblyLinearVelocity = Vector3.new(0, v0.Y, 0)
            CR.AssemblyAngularVelocity = Vector3.zero
        end
        pcall(function() warn("[XDG-Speed] 速度设置为 " .. US) end)
    end
    SpeedAPIs.setSpeed = SetSpeed
    SpeedAPIs.getSpeed = function() return US end
    SetSpeed(TARGET_SPEED)
    pcall(function()
        local env = getgenv and getgenv() or _G
        env.XDG_SpeedBypass = SpeedAPIs
    end)
end)

