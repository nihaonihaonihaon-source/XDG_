SafeRun("Chilli.AntiRagdoll", function()
    local Ragdoll = nil
    pcall(function() Ragdoll = require(ReplicatedStorage.Shared.Modules.Ragdoll) end)
    local v28 = nil
    local v30 = nil
    local flag6 = false
    local conns = {}
    local heartbeatConn = nil
    local function getControls()
        if v28 then return v28 end
        local ok, result = pcall(function()
            local PM = require(localPlayer:WaitForChild("PlayerScripts", 5):WaitForChild("PlayerModule", 5))
            return PM:GetControls()
        end)
        if ok then v28 = result end
        return v28
    end
    local function force()
        if not v30 then return end
        local humanoid = v30:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return end
        if humanoid.PlatformStand then humanoid.PlatformStand = false end
        if Ragdoll and type(Ragdoll.ClearClientRagdoll) == "function" then
            pcall(Ragdoll.ClearClientRagdoll)
        end
        if Ragdoll and type(Ragdoll.Unragdoll) == "function" then
            pcall(Ragdoll.Unragdoll, v30)
        end
        for _, d in ipairs(v30:GetDescendants()) do
            if d:IsA("Motor6D") and not d.Enabled then
                pcall(function() d.Enabled = true end)
            end
        end
        local c = getControls()
        if c and c.controlsEnabled == false then pcall(function() c:Enable() end) end
        local cam = workspace.CurrentCamera
        if cam and cam.CameraSubject ~= humanoid then
            pcall(function() cam.CameraSubject = humanoid end)
        end
    end
    local function bind(char)
        for _, c in ipairs(conns) do SafeDisconnect(c) end
        conns = {}
        if heartbeatConn then SafeDisconnect(heartbeatConn) heartbeatConn = nil end
        flag6 = true
        v30 = char
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end
        table.insert(conns, TrackConn(humanoid.StateChanged:Connect(function(_, new)
            if new == Enum.HumanoidStateType.Physics
                or new == Enum.HumanoidStateType.Ragdoll
                or new == Enum.HumanoidStateType.FallingDown then
                task.defer(force)
            end
        end)))
        heartbeatConn = TrackConn(RunService.Heartbeat:Connect(function()
            if not flag6 or not v30 then return end
            local h = v30:FindFirstChildOfClass("Humanoid")
            if not h or h.Health <= 0 then return end
            if h.PlatformStand
                or h:GetState() == Enum.HumanoidStateType.Physics
                or h:GetState() == Enum.HumanoidStateType.Ragdoll then
                force()
            end
        end))
        force()
    end
    table.insert(conns, TrackConn(localPlayer.CharacterAdded:Connect(function(c)
        task.defer(bind, c)
    end)))
    if localPlayer.Character then task.defer(bind, localPlayer.Character) end
end)

